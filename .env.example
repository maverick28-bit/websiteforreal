# ── Required ──────────────────────────────────────────────────────────────────

# Comma-separated API keys (Gemini, OpenAI, Anthropic, etc.)
LLM_API_KEYS=your_gemini_key_1,your_gemini_key_2

# LiteLLM model string — e.g. gemini/gemini-2.0-flash or gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite database path (Docker default: /data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable X-Simulate-Failure header for failover testing (true|false)
ENABLE_FAILURE_SIMULATION=true

# ── Optional ──────────────────────────────────────────────────────────────────

# Default system prompt shown in UI
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.
